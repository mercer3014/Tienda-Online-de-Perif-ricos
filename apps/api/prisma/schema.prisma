// ==========================================================================
// Villano Gamer Store - Esquema Prisma (PostgreSQL)
// Normalizado (>= 3FN). PK UUID en todas las tablas. FKs con integridad
// referencial e indices en columnas filtradas/ordenadas con frecuencia.
// Borrado logico (status/active) en products y categories.
// El stock_status NO se almacena: es un dato derivado que calcula la API
// a partir de stock_quantity (evita redundancia / anomalias de update).
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------- Enums -----------------------------------

enum ProductStatus {
  activo
  inactivo
}

enum OrderStatus {
  pendiente
  coordinado
  completado
  cancelado
}

enum ProductEventType {
  view
  add_to_cart
  whatsapp_click
}

// ------------------------------ Catalogo ----------------------------------

/// Arbol jerarquico de categorias (auto-referencia via parentId).
model Category {
  id             String     @id @default(uuid()) @db.Uuid
  parentId       String?    @map("parent_id") @db.Uuid
  name           String     @db.VarChar(120)
  slug           String     @unique @db.VarChar(160)
  isPromo        Boolean    @default(false) @map("is_promo")
  promoBadgeText String?    @map("promo_badge_text") @db.VarChar(60)
  displayOrder   Int        @default(0) @map("display_order")
  // Borrado logico: no se elimina fisicamente para no romper productos/pedidos.
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([displayOrder])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String        @db.VarChar(180)
  slug        String        @unique @db.VarChar(160)
  description String        @default("") @db.Text
  brand       String?       @db.VarChar(80)
  basePrice   Decimal       @map("base_price") @db.Decimal(12, 2)
  // Precio "antes" para promociones (tachado en el catalogo). Null = sin oferta.
  originalPrice Decimal?    @map("original_price") @db.Decimal(12, 2)
  // Borrado logico via status = inactivo (nunca DELETE fisico).
  status      ProductStatus @default(activo)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  images   ProductImage[]
  variants ProductVariant[]
  events   ProductEvent[]

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  urlWebp      String  @map("url_webp") @db.VarChar(500)
  displayOrder Int     @default(0) @map("display_order")
  isPrimary    Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Definicion de un atributo (ej. "Tipo de switch", "Conectividad", "Formato").
model Attribute {
  id     String           @id @default(uuid()) @db.Uuid
  name   String           @unique @db.VarChar(80)
  values AttributeValue[]

  @@map("attributes")
}

/// Valor concreto de un atributo (ej. "Blue", "TKL"). Unico por atributo.
model AttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String @db.VarChar(80)

  attribute Attribute                @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variants  VariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_values")
}

model ProductVariant {
  id            String  @id @default(uuid()) @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  sku           String  @unique @db.VarChar(64)
  price         Decimal @db.Decimal(12, 2)
  // Cantidad real en inventario. El stock_status se DERIVA de aqui en la API.
  stockQuantity Int     @default(0) @map("stock_quantity")

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attributeValues VariantAttributeValue[]
  orderItems      OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

/// Tabla puente variante <-> valor de atributo (muchos-a-muchos).
model VariantAttributeValue {
  variantId        String @map("variant_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

// ------------------------------- Pedidos ----------------------------------

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  orderNumber   String      @unique @map("order_number") @db.VarChar(30)
  customerPhone String?     @map("customer_phone") @db.VarChar(30)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(12, 2)
  status        OrderStatus @default(pendiente)
  whatsappSent  Boolean     @default(false) @map("whatsapp_sent")
  createdAt     DateTime    @default(now()) @map("created_at")

  items OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Item de pedido con SNAPSHOT de nombre/variante y precio: si el producto
/// cambia despues, el historico del pedido no se altera.
model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  // variantId puede quedar null si la variante se elimina: el snapshot preserva el dato.
  variantId    String? @map("variant_id") @db.Uuid
  productName  String  @map("product_name") @db.VarChar(200)
  variantLabel String  @default("") @map("variant_label") @db.VarChar(200)
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal     Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ------------------------------ Metricas ----------------------------------

model ProductEvent {
  id        String           @id @default(uuid()) @db.Uuid
  productId String           @map("product_id") @db.Uuid
  eventType ProductEventType @map("event_type")
  sessionId String           @map("session_id") @db.VarChar(120)
  createdAt DateTime         @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@index([eventType])
  @@index([createdAt])
  @@index([sessionId])
  @@map("product_events")
}

// ---------------------- Usuarios / Roles / Permisos -----------------------

model Role {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(80)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(60)
  description String @default("") @db.VarChar(200)

  roles RolePermission[]

  @@map("permissions")
}

/// Matriz configurable de permisos por rol.
model RolePermission {
  roleId       String  @map("role_id") @db.Uuid
  permissionId String  @map("permission_id") @db.Uuid
  allowed      Boolean @default(false)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(160)
  passwordHash String   @map("password_hash") @db.VarChar(200)
  // Borrado logico: personal desactivado en vez de eliminado.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  role     Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditLog AuditLog[]

  @@index([roleId])
  @@map("users")
}

/// Bitacora de cambios (creacion/edicion/eliminacion de entidades clave).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  // Se conserva el registro aunque el usuario se elimine (SetNull).
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(60)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_log")
}

// ------------------------- Tienda (horario/ubicacion) ---------------------

model BusinessHour {
  id        String  @id @default(uuid()) @db.Uuid
  dayOfWeek Int     @unique @map("day_of_week") // 0=domingo ... 6=sabado
  openTime  String  @map("open_time") @db.VarChar(5) // "HH:mm"
  closeTime String  @map("close_time") @db.VarChar(5) // "HH:mm"
  isClosed  Boolean @default(false) @map("is_closed")

  @@map("business_hours")
}

model StoreLocation {
  id            String  @id @default(uuid()) @db.Uuid
  mallName      String  @map("mall_name") @db.VarChar(160)
  address       String  @db.VarChar(240)
  passageNumber String? @map("passage_number") @db.VarChar(30)
  localeNumber  String? @map("locale_number") @db.VarChar(30)
  latitude      Float?
  longitude     Float?
  googleMapsUrl String? @map("google_maps_url") @db.VarChar(500)
  wazeUrl       String? @map("waze_url") @db.VarChar(500)

  @@map("store_location")
}
