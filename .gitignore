# Dependencias
node_modules/
.pnpm-store/

# Variables de entorno y credenciales (NUNCA commitear)
.env
.env.local
.env.*.local
*.env
apps/api/.env
apps/web/.env
apps/admin/.env

# Salida de compilación / Build outputs
dist/
build/
out/
.next/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# Uploads de imágenes en runtime (archivos subidos desde el panel admin)
# Se ignoran los uploads en runtime salvo los assets fuente del seed (catalogo_imagenes)
apps/api/uploads/*
!apps/api/uploads/.gitkeep
!apps/api/uploads/seed
apps/api/uploads/seed/*
!apps/api/uploads/seed/catalogo_imagenes

# Logs y temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
.eslintcache

# Archivos de SO y editores de código
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Herramientas de desarrollo, cache y testing
.vite/
.turbo/
coverage/
.nyc_output/

# Vercel (link local proyecto -> deployment, especifico de cada maquina)
.vercel
