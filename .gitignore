# Dependencies
node_modules/
.pnpm-store/

# Environment (NUNCA commitear credenciales)
.env
.env.local
.env.*.local
apps/api/.env
apps/web/.env
apps/admin/.env

# Build output
dist/
build/
*.tsbuildinfo

# Prisma
apps/api/prisma/*.db

# Uploads en runtime (imagenes subidas desde el admin) — NO versionar,
# pero SI versionar las imagenes fuente del catalogo (assets del seed).
apps/api/uploads/*
!apps/api/uploads/.gitkeep
!apps/api/uploads/seed
apps/api/uploads/seed/*
!apps/api/uploads/seed/catalogo_imagenes

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Vite / cache
.vite/
coverage/
