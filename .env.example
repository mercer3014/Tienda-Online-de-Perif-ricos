# ==========================================================================
# Villano Gamer Store - Variables de entorno (EJEMPLO)
# Copia este archivo a `.env` y completa los valores reales.
# El archivo `.env` NUNCA debe commitearse (esta en .gitignore).
# ==========================================================================

# --- PostgreSQL (usado por docker-compose y por Prisma) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=villano_gamer_store
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Prisma / Backend ---
# Cadena de conexion completa. Debe coincidir con las credenciales de arriba.
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/villano_gamer_store?schema=public"

# --- API ---
API_PORT=4000
NODE_ENV=development

# --- Autenticacion (panel admin) ---
# Genera un secreto largo y aleatorio: `openssl rand -base64 48`
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# --- CORS (origenes permitidos del frontend/admin, separados por coma) ---
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Almacenamiento de imagenes ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# --- Datos de la tienda (para WhatsApp checkout) ---
STORE_WHATSAPP_NUMBER=59170000000
STORE_TIMEZONE=America/La_Paz

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000/api
VITE_STORE_WHATSAPP_NUMBER=59170000000
